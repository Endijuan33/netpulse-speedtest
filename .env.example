# NetPulse environment variables — no real secrets here.
# Optional: override the public IP-info providers (defaults are used when unset).
# IP_API_BASE_URL=https://ip-api.com
# IPAPI_BASE_URL=https://ipapi.co
# Rate-limit tuning (requests per window, per IP)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
